#
# Minimal ARM64 QEMU kernel for Rust-for-Linux development
#

# Userspace basics
CONFIG_MULTIUSER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y

# Rust
CONFIG_RUST=y

# KUnit
CONFIG_KUNIT=y
# CONFIG_KUNIT_ALL_TESTS is not set
CONFIG_KUNIT_DEFAULT_ENABLED=y
CONFIG_KUNIT_AUTORUN_ENABLED=y

# Temporary baseline test.
# Remove this once dma::Range has its own test.
CONFIG_KUNIT_EXAMPLE_TEST=y

# Console
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# External initramfs supplied by QEMU -initrd
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Minimal /dev, /proc, /sys and /tmp
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# No loadable modules in the QEMU inner development loop
# CONFIG_MODULES is not set

# Keep expensive debug information out of the fast build
# CONFIG_DEBUG_INFO is not set
