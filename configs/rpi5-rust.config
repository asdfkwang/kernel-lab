#
# Raspberry Pi 5 Rust-for-Linux development fragment (skeleton).
# Do NOT reuse qemu-arm64-rust.config here; real hardware needs
# platform, Ethernet, and NFS-root support. Exact symbols TBD
# from the current kernel source (TODO).
#

# Userspace basics
CONFIG_MULTIUSER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y

# Rust
CONFIG_RUST=y

# KUnit (same tests as QEMU first, Pi second)
CONFIG_KUNIT=y
# CONFIG_KUNIT_ALL_TESTS is not set
CONFIG_KUNIT_DEFAULT_ENABLED=y
CONFIG_KUNIT_AUTORUN_ENABLED=y

# Temporary baseline test.
# Remove this once dma::Range has its own test.
CONFIG_KUNIT_EXAMPLE_TEST=y

# Console
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# Root fs / userspace
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# TODO: BCM2712 / RPi5 platform, GIC, arch timer, DTB
# TODO: Ethernet + TCP/IP + NFS client + NFS root
# TODO: SD/MMC (only if SD fallback/root is tested)
# TODO: PCIe / RP1 as required by current upstream
