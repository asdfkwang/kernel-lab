#
# Unified minimal ARM64 Rust-for-Linux kernel: one Image boots both
# QEMU virt (initramfs) and Raspberry Pi 5 (NFS root).
#
# Base is arm64 defconfig (covers virt + BCM platform drivers).
# This fragment only forces Rust/KUnit on, promotes the handful of
# drivers that defconfig leaves as modules to builtin (modules are
# disabled below), and documents the boot-critical options explicitly.
#

# Userspace basics
CONFIG_MULTIUSER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y

# Rust
CONFIG_RUST=y

# KUnit
CONFIG_KUNIT=y
# CONFIG_KUNIT_ALL_TESTS is not set
CONFIG_KUNIT_DEFAULT_ENABLED=y
CONFIG_KUNIT_AUTORUN_ENABLED=y

# Temporary baseline test.
# Remove this once dma::Range has its own test.
CONFIG_KUNIT_EXAMPLE_TEST=y

# Console (PL011 on both virt and RPi5)
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# QEMU virt essentials (already =y in defconfig; explicit here)
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# RPi5 essentials: these are =m in defconfig, forced builtin
# because loadable modules are disabled below.
# PCIe host + RP1 southbridge + RP1 Ethernet (Cadence MACB).
CONFIG_PCIE_BRCMSTB=y
CONFIG_MISC_RP1=y
CONFIG_MACB=y

# Initramfs (QEMU -initrd) and NFS root (Pi)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_NFS_FS=y
CONFIG_ROOT_NFS=y

# Minimal /dev, /proc, /sys and /tmp
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# No loadable modules: everything needed must be =y above.
# CONFIG_MODULES is not set

# Keep expensive debug information out of the fast build.
# (DEBUG_INFO_NONE flips the defconfig DWARF choice off.)
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO is not set
