#
# Minimal fragment: plain defconfig + KUnit only.
#
# Everything else from the old unified fragment (Rust, virtio, RPi5
# builtins, NFS root, netconsole, debug-info tweaks) is intentionally
# removed for now. Restore from git history when needed:
#   git log --oneline -- configs/arm64-rust-minimal.config
#

# KUnit
CONFIG_KUNIT=y
# CONFIG_KUNIT_ALL_TESTS is not set
CONFIG_KUNIT_DEFAULT_ENABLED=y
CONFIG_KUNIT_AUTORUN_ENABLED=y

# Temporary baseline test.
# Remove this once dma::Range has its own test.
CONFIG_KUNIT_EXAMPLE_TEST=y

# Rust (for the dma::Range work; rest of the old fragment still trimmed)
CONFIG_RUST=y
